---
import MarketTickerBar from "../components/MarketTickerBar.astro";
import {
  DISCOVER_PAGE,
  FOOTER,
  MAP_PAGE,
  NEWS_PAGE,
  RESEARCH_PAGE,
  SIGNALS_PAGE,
  SITE,
} from "../lib/ui";

interface Props {
  title: string;
  description?: string;
  /** 相對於網站根路徑的社群預覽圖 */
  ogImage?: string;
  /** 不讓搜尋引擎索引（例如預覽環境） */
  noIndex?: boolean;
  /** 頁面層級 JSON-LD 結構化資料(單一或陣列),會與全站 Organization 一併輸出 */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description = SITE.desc,
  ogImage = "/og-default.svg",
  noIndex = false,
  jsonLd,
} = Astro.props;

const siteBase = Astro.site ?? new URL("/", Astro.url);
const canonicalUrl = new URL(Astro.url.pathname + Astro.url.search, siteBase);
const ogImageUrl = new URL(ogImage, siteBase);

const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.name,
  url: siteBase.href,
};
const pageLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const navPath = Astro.url.pathname;
const navActive = (href: string) =>
  navPath === href || navPath.startsWith(href + "/");
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0c0e" />
    <script is:inline>
      /* 深/淺色:繪製前先套用(避免閃白);預設跟隨系統,使用者選擇存 localStorage "tw-theme"(與個人版同鍵) */
      (function () {
        var root = document.documentElement;
        var saved = null;
        try {
          saved = localStorage.getItem("tw-theme");
        } catch (e) {}
        var t =
          saved ||
          (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
        root.dataset.theme = t === "light" ? "light" : "dark";
      })();
    </script>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:locale" content="zh_TW" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    {pageLdList.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/fin-dash.css" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav" aria-label="Main navigation">
        <a class="brand" href="/">{SITE.name}</a>
        {/*
          導覽 = 找訊探索股票的四條路:產業 / 題材 / 探索 / 自選。

          🔴 **移出導覽 ≠ 刪除。** 以下頁面都還在,各自有入口:
            /screener  選股器   ← 自選股頁的「選股器」鈕、比較頁空狀態
            /compare   比較     ← 自選股頁的「並排比較」鈕
            /news      新聞     ← 頁尾次要導覽(實查:全站原本零入口)
            /signals   回測     ← 自選股頁逐檔的「看回測 →」+ 頁尾
            /research  研究方法 ← 頁尾次要導覽(實查:全站原本零入口)
            /trades    投資組合 ← 僅能由網址進入(退役評估中,見 web/docs/ticker-and-coverage.md)
            /report/[ticker]    ← **13 個檔案的去處**,不得刪除;理由見同一份文件

          ⚠️ 移出前先確認「還連得到」。孤立頁面與刪除的差別,對使用者是看不出來的。
        */}
        <div class="nav-links" id="nav-links">
          <a href="/sectors" aria-current={navActive("/sectors") ? "page" : undefined}>產業</a>
          <a href="/map" aria-current={navActive("/map") ? "page" : undefined}>{MAP_PAGE.nav}</a>
          <a href="/discover" aria-current={navActive("/discover") ? "page" : undefined}>{DISCOVER_PAGE.nav}</a>
          <a href="/watchlist" aria-current={navActive("/watchlist") ? "page" : undefined}>自選</a>
        </div>
        {/* 切換鈕置於 .nav-links 之外 → 不隨導覽橫向捲動 */}
        <button
          id="tw-theme-btn"
          class="theme-toggle"
          type="button"
          title="切換深／淺色"
          aria-label="切換深淺色主題"
        >☾</button>
      </nav>
    </header>
    <script is:inline>
      /* 切換鈕:只換 data-theme 與 theme-color,不影響資料/功能 */
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById("tw-theme-btn");
        var meta = document.querySelector('meta[name="theme-color"]');
        function paint(t) {
          root.dataset.theme = t;
          if (btn) btn.textContent = t === "dark" ? "☾" : "☀";
          if (meta) meta.setAttribute("content", t === "light" ? "#f6f3ea" : "#0b0c0e");
          window.dispatchEvent(new CustomEvent("tw-theme-change", { detail: { theme: t } }));
        }
        paint(root.dataset.theme === "light" ? "light" : "dark");
        if (btn) {
          btn.addEventListener("click", function () {
            var next = root.dataset.theme === "dark" ? "light" : "dark";
            paint(next);
            try {
              localStorage.setItem("tw-theme", next);
            } catch (e) {}
          });
        }
      })();
    </script>
    <MarketTickerBar />
    <main class="main">
      <slot />
    </main>
    <footer class="site-footer">
      {/*
        🔴 次要導覽。移出主導覽的頁面**必須有入口**,否則「頁面保留」在畫面上
           與「刪除」沒有差別。實查(2026-10-10):
             /screener /compare /signals 已有入口(自選股頁、比較頁)
             /news /research **全站零入口** → 收在這裡
             /trades 退役評估中,刻意不給入口,見 web/docs/ticker-and-coverage.md
      */}
      <nav class="footer-nav" aria-label="次要導覽">
        <a href="/news">{NEWS_PAGE.nav}</a>
        <a href="/screener">選股器</a>
        <a href="/compare">比較</a>
        <a href="/signals">{SIGNALS_PAGE.nav}</a>
        <a href="/research">{RESEARCH_PAGE.nav}</a>
      </nav>
      <p class="footer-disclaimer" role="note">{FOOTER.disclaimer}</p>
      <p class="footer-source">
        資料來源：<a
          href="https://github.com/meishihna/twstock-web"
          target="_blank"
          rel="noopener">GitHub · meishihna / TWstock</a
        >
      </p>
    </footer>
  </body>
</html>
